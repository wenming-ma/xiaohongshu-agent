# Xiaohongshu Agent environment template

# Anthropic API (required for the default article/image workflow)
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_FALLBACK_BASE_URL=http://127.0.0.1:8045
# ANTHROPIC_FALLBACK_API_KEY=your-anthropic-fallback-api-key
# CLAUDE_IMAGE_MODEL=claude-sonnet-4-5-20250929

# MiniMax API (required by the research workflow and default video flow)
MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_OPENAI_BASE_URL=https://api.minimaxi.com/v1

# OpenRouter API (optional)
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_IMAGE_MODEL=qwen/qwen-2.5-vl-7b-instruct:free

# Gemini API (required when enabling image generation through Gemini APIs)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_FALLBACK_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
# GOOGLE_VISION_MODEL=gemini-2.5-pro

# Vertex AI image and vision options
# VERTEX_AI_PROJECT_ID=your-gcp-project-id
# VERTEX_AI_LOCATION=global
# VERTEX_AI_IMAGE_MODEL=gemini-3-pro-image-preview
# VERTEX_AI_VISION_MODEL=gemini-2.5-flash

# Image workflow limits
# IMAGE_MAX_AUTO_IMAGES=9
# IMAGE_GENERATION_CONCURRENCY=3

# Research workflow budgets
# RESEARCH_MAX_NEW_POSTS_PER_ITERATION=3
# RESEARCH_PER_ITERATION_REQUEST_LIMIT=30
# RESEARCH_PER_ITERATION_TOOL_CALLS_LIMIT=60
# RESEARCH_POST_IMAGE_READER_MAX_IMAGES=3
# RESEARCH_POST_IMAGE_READER_REQUEST_LIMIT=8
# RESEARCH_POST_IMAGE_READER_TOOL_CALLS_LIMIT=12

# Feishu Agent OS entrypoint and delivery settings
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_RUNTIME_ENV=dev
FEISHU_CHAT_DEV_ID=your-dev-feishu-chat-id
FEISHU_CHAT_DEPLOY_ID=your-deploy-feishu-chat-id
# FEISHU_CHAT_ID=your-override-feishu-chat-id

# Android Rednote/Xiaohongshu QR login (optional)
# XHS_ANDROID_QR_ENABLED=true
# ANDROID_SERIAL=your-android-device-serial
# XHS_ANDROID_SERIAL=your-android-device-serial
# XHS_ANDROID_WIRELESS_ENDPOINT=127.0.0.1:5555

# Logfire observability (optional)
# LOGFIRE_TOKEN=your-logfire-token
# LOGFIRE_READ_TOKEN=your-logfire-read-token

# Browser and logging
# HEADLESS=true
# LOG_LEVEL=INFO

# Model routing
# MODEL_PROVIDER=minimax
# MAIN_AGENT_MODEL=gpt-5.5

# Search providers (optional)
# SERPER_API_KEY=your-serper-api-key
# TAVILY_API_KEY=your-tavily-api-key

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id
# TELEGRAM_TOOL_FEEDBACK_ENABLED=1
